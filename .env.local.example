# Supabase
# Supabaseプロジェクトの Settings > API から取得してください
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key（サーバーサイド専用・公開禁止）
# Settings > API > Project API keys > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anthropic (Claude Vision) - 領収書解析に使用
# https://console.anthropic.com から取得
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# アプリの公開URL（メール内リンクに使用）
NEXT_PUBLIC_APP_URL=https://your-app.example.com

# Resend（メール送信）
# https://resend.com からAPIキーを取得
# 送信元アドレスは Resend で検証済みドメインのアドレスを使用すること
RESEND_API_KEY=re_your-api-key-here
RESEND_FROM_EMAIL=noreply@your-domain.com
